# ============================================
# Job Application Bot — Configuration
# ============================================

# --- Email (Gmail SMTP) ---
# Use an App Password, NOT your Gmail password.
# Enable 2FA then get one at: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=mehdi2002aichouch@gmail.com
EMAIL_PASSWORD=your_16_char_gmail_app_password

# --- Groq API (FREE — no credit card needed) ---
# Create free account at: https://console.groq.com → API Keys
GROQ_API_KEY=

# --- Hunter.io (OFF by default — capped free tier) ---
# The bot runs fully on free, unlimited methods (site scraping + Clearbit domain
# lookup + MX validation). Hunter is opt-in only; leave USE_HUNTER=false to stay
# on purely-free mode. Set both to true only if you want the 25/month free lookups.
USE_HUNTER=false
HUNTER_API_KEY=

# --- Adzuna API (Optional — free tier) ---
# Register at: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# --- Bot Settings ---
MAX_JOBS_PER_RUN=10
DRY_RUN=false

# --- Digest ---
# Email a ranked shortlist digest after each run (to DIGEST_TO, defaults to EMAIL_ADDRESS).
SEND_DIGEST=true
DIGEST_TO=

# --- Canada relocation track ---
# Also target Canadian listings and pitch the relocation / work-permit angle
# in cover letters and emails (see CANADA_PITCH in job_bot/config.py).
CANADA_TRACK=true

# phone shown in email signatures (optional)
CONTACT_PHONE=
